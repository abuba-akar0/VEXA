{
  "$schema": "https://schema.tauri.app/v2/capability",
  "identifier": "default",
  "description": "Default capabilities for VEXA transparent overlay",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-focus",
    "core:event:default",
    "global-shortcut:default"
  ]
}
